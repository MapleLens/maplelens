{
  "name": "MapleLens Phone",
  "short_name": "MapleLens",
  "description": "Notifications from your MapleLens store: sold items, the store opening and closing.",
  "lang": "en",
  "dir": "ltr",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
